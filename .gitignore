# =============================================================================
# Investigation folder - may contain sensitive data (device captures, PHI,
# credentials, USB traces, patient-adjacent logs, etc.)
# Only Markdown notes inside this tree are committed; everything else is ignored.
# =============================================================================
dermoscope_investigation/**
!dermoscope_investigation/
!dermoscope_investigation/**/
!dermoscope_investigation/**/*.md

# =============================================================================
# macOS
# =============================================================================
.DS_Store
.AppleDouble
.LSOverride
._*

# =============================================================================
# Windows
# =============================================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# =============================================================================
# Editors / IDEs
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# =============================================================================
# Go (dermoscope-helper/)
# =============================================================================
# Build output
dermoscope-helper/dist/
dist/

# Compiled binaries and platform-specific executables
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go tooling
vendor/
go.work
go.work.sum

# Coverage
coverage.out
coverage.html
*.cover

# =============================================================================
# C++ Windows helper (windows-helper/) - build output only
# The generic `dist/` and `*.exe` rules above already cover most of this; these
# entries are spelled out so it is obvious what `make` / `make static` drops on
# the floor. Sources stay tracked: helper.cpp, helper.rc, Makefile and the
# app icon under windows-helper/assets/ are all committed - do NOT ignore
# windows-helper/assets/ or *.ico.
# =============================================================================
# `make shared` output (exe + mingw runtime DLLs)
windows-helper/dist/
# `make static` output (single self-contained exe)
windows-helper/dist-static/
# `make installer` output (Inno Setup per-user installer exe)
windows-helper/dist-installer/
# intermediate objects, including the windres-compiled resource object
windows-helper/build/

# =============================================================================
# Python (prototype helpers + investigation venv)
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/
*/dermoscope_env/

# =============================================================================
# Logs and runtime artifacts
# =============================================================================
*.log
logs/
dermoscope-helper.log

# =============================================================================
# Secrets / environment / credentials
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
credentials.json
secrets.json

# =============================================================================
# USB / device capture artifacts (often generated during investigation)
# =============================================================================
*.pcap
*.pcapng
*.usbmon

# =============================================================================
# Archives (typically build outputs, not source)
# =============================================================================
*.zip
*.tar
*.tar.gz
*.tgz


.claude
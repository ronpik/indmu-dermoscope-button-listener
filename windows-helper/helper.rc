/*
 * Win32 resource script for the dermoscope helper.
 *
 * Carries two things:
 *   1. The application icon (IDI_APP == 101), used by Explorer, the taskbar
 *      and the tray. Load it at runtime with:
 *          LoadIcon(hInstance, MAKEINTRESOURCE(IDI_APP))
 *   2. A VERSIONINFO block. Real, populated version metadata materially
 *      reduces SmartScreen / AV false positives on an unsigned mingw-w64
 *      binary, so keep these strings looking like a real product.
 *
 * Built by the Makefile:
 *     windres --include-dir . -DVER_MAJOR=1 -DVER_MINOR=4 -DVER_PATCH=2 \
 *             -DVER_BUILD=0 -DVER_STRING='\"1.4.2\"' -i helper.rc -o helper_res.o -O coff
 *
 * (windres re-shells its -D flags on the way to the preprocessor, hence the
 * backslash-escaped quotes around the version string.)
 *
 * The defaults below keep a bare `windres helper.rc` working with no -D flags.
 */

#include <windows.h>

/* --- Application icon ------------------------------------------------- */

#ifndef IDI_APP
#define IDI_APP 101
#endif

IDI_APP ICON "assets/helper.ico"

/* --- Version numbers (overridden by -D from the Makefile) -------------- */

#ifndef VER_MAJOR
#define VER_MAJOR 0
#endif
#ifndef VER_MINOR
#define VER_MINOR 0
#endif
#ifndef VER_PATCH
#define VER_PATCH 0
#endif
#ifndef VER_BUILD
#define VER_BUILD 0
#endif

/* Dotted string form. If the Makefile did not hand us one, stitch it
 * together from the numeric components so the block is never empty. */
#ifndef VER_STRING
#define VER_STR2(x) #x
#define VER_STR1(x) VER_STR2(x)
#define VER_STRING  VER_STR1(VER_MAJOR) "." VER_STR1(VER_MINOR) "." VER_STR1(VER_PATCH)
#endif

/* --- VERSIONINFO ------------------------------------------------------- */

VS_VERSION_INFO VERSIONINFO
FILEVERSION    VER_MAJOR,VER_MINOR,VER_PATCH,VER_BUILD
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,VER_BUILD
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"          /* US English, Unicode */
        BEGIN
            VALUE "CompanyName",      "Indmu"
            VALUE "FileDescription",  "Dermoscope Helper"
            VALUE "FileVersion",      VER_STRING
            VALUE "InternalName",     "helper"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Indmu"
            VALUE "OriginalFilename", "helper.exe"
            VALUE "ProductName",      "Dermoscope Helper"
            VALUE "ProductVersion",   VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
